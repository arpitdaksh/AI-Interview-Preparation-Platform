PORT=3000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional: defaults to openai/gpt-oss-20b:free
OPENROUTER_CHAT_MODEL=openai/gpt-oss-20b:free
# Razorpay: keep secret values only in the backend hosting environment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Pro access lasts 30 days. Amount is in paise (19900 = ₹199).
PRO_MONTHLY_PRICE_PAISE=19900
# Optional additional allowed frontend origin, for example http://localhost:5173
CORS_ORIGIN=http://localhost:5173
